# ==============================================================
# Fichier d'exemple — copier en .env et renseigner des valeurs réelles.
# .env ne doit JAMAIS être commité (voir .gitignore).
# ==============================================================

# --- Clés RS256 : signature des JWT de séance (RF-04) et des attestations (RF-19) ---
# Générées par ./generate_keys.sh, jamais commitées (dossier keys/ gitignoré).
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem

# --- MySQL ---
# Le conteneur MySQL hébergera à terme DEUX bases logiques distinctes (source 4.4/4.8) :
#   - db_logs         : journaux opérationnels (scans, corrections) — purgés en fin d'UF (RF-20)
#   - db_attestations : attestations certifiées — conservées 5 ans, accès restreint (RF-19, S-J5)
# L'image officielle MySQL ne crée automatiquement que MYSQL_DATABASE au premier démarrage.
# La création de db_attestations et la séparation stricte des privilèges (l'utilisateur
# applicatif standard n'aura AUCUN droit d'écriture sur db_attestations, seul le service
# d'attestation y écrit) sera provisionnée par un script d'initialisation SQL dédié à
# l'étape suivante (modèle de données, section 4.4). Non traité dans cette Partie 1.
MYSQL_ROOT_PASSWORD=changeme_root_password
MYSQL_DATABASE=db_logs
MYSQL_USER=app_logs
MYSQL_PASSWORD=changeme_app_password
MYSQL_HOST=mysql
MYSQL_PORT=3306

# Utilisateur dedie a la base db_attestations, cree par database/03-privileges.sh.
# Restreint a SELECT+INSERT sur db_attestations uniquement (aucun droit sur
# db_logs). Le pool applicatif principal (backend/src/config/db.js) n'utilise
# PAS ces identifiants a ce stade : ils seront consommes par le futur service
# d'attestation (RF-19), pas encore implemente.
MYSQL_ATTESTATIONS_DATABASE=db_attestations
MYSQL_ATTESTATIONS_USER=app_attestations
MYSQL_ATTESTATIONS_PASSWORD=changeme_attestations_password

# --- Application (préparé pour les étapes suivantes du backend) ---
NODE_ENV=development
PORT=3000
